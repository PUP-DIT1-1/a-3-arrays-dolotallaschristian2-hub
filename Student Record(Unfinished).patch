FILE_NAME = "students.txt"

# ---------- FILE HANDLING ----------
def load_data():
    students = []

    try:
        with open(FILE_NAME, "r") as file:
            for line in file:

                if line:
                    name, grades_text, avg = line.split("|")
                    grades = [int(g) for g in grades_text.split(",")]

                    students.append({
                        "name": name,
                        "grades": grades,
                        "average": float(avg)
                    })

    except FileNotFoundError:
        pass

    return students


def save_data(students):
    with open(FILE_NAME, "w") as file:
        for student in students:
            grades_text = ",".join(map(str, student["grades"]))
            line = f"{student['name']}|{grades_text}|{student['average']}\n"
            file.write(line)


# ---------- ADD STUDENT ----------
def add_student(students):
    print("\n--- Add New Student ---")
    name = input("Enter student name: ")

    num_grades = int(input("How many grades? "))
    grades = []

    for i in range(num_grades):
        grade = int(input(f"Enter grade #{i + 1}: "))
        grades.append(grade)

    average = sum(grades) / num_grades

    students.append({
        "name": name,
        "grades": grades,
        "average": average
    })

    print("Student successfully added!\n")


# ---------- VIEW STUDENTS ----------
def view_students(students):
    if not students:
        print("\nNo student records yet.\n")
        return

    print("\n--- Student Records (Sorted by Average) ---")

    sorted_list = sorted(students, key=lambda s: s["average"], reverse=True)

    for student in sorted_list:
        grades_display = " ".join(map(str, student["grades"]))
        print(f"{student['name']} - {grades_display} | Avg: {student['average']:.2f}")

    print()


# ---------- SEARCH STUDENT ----------
def search_student(students):
    name = input("\nEnter name to search: ")

    for student in students:
        if student["name"].lower() == name.lower():
            print("\nStudent Found:")
            print(f"{student['name']} - {' '.join(map(str, student['grades']))} | Avg: {student['average']:.2f}")
            return

    print("Student not found.\n")


# ---------- REMOVE STUDENT ----------
def remove_student(students):
    name = input("\nEnter name to remove: ")

    for student in students:
        if student["name"].lower() == name.lower():
            students.remove(student)
            print("Student removed successfully!\n")
            return

    print("Student not found.\n")


# ---------- MAIN PROGRAM ----------
def main():
    students = load_data()

    while True:
        print("===== STUDENT MENU =====")
        print("1. Add Student")
        print("2. View Students")
        print("3. Search Student")
        print("4. Remove Student")
        print("5. Exit")

        choice = input("Choose an option: ")

        if choice == "1":
            add_student(students)
            save_data(students)

        elif choice == "2":
            view_students(students)

        elif choice == "3":
            search_student(students)

        elif choice == "4":
            remove_student(students)
            save_data(students)

        elif choice == "5":
            save_data(students)
            print("Data saved. Goodbye!")
            break

        else:
            print("Invalid choice. Please try again.\n")


# Run the program
main()