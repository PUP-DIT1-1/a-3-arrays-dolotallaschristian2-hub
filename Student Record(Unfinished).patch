FILE_NAME = "students.txt"

# ---------------- FILE HANDLING ----------------
def load_data():
    records = []
    try:
        with open(FILE_NAME, "r") as f:
            for line in f:
                line = line.strip()
                if line:
                    name, grades_str, avg = line.split("|")
                    grades = list(map(int, grades_str.split(",")))
                    records.append({
                        "name": name,
                        "grades": grades,
                        "avg": float(avg)
                    })
    except FileNotFoundError:
        pass
    return records


def save_data(records):
    with open(FILE_NAME, "w") as f:
        for student in records:
            grades_str = ",".join(map(str, student["grades"]))
            line = f"{student['name']}|{grades_str}|{student['avg']}\n"
            f.write(line)


# ---------------- ADD STUDENT ----------------
def add_student(records):
    name = input("\nStudent name: ")

    grades_count = int(input("Enter number of grades: "))
    student_grades = []
    total = 0

    for i in range(grades_count):
        grade = int(input(f"Grade {i + 1}: "))
        student_grades.append(grade)
        total += grade

    avg = total / grades_count
    records.append({"name": name, "grades": student_grades, "avg": avg})

    print("Student added successfully!")


# ---------------- VIEW STUDENTS ----------------
def view_students(records):
    if not records:
        print("\nNo records found.")
        return

    sorted_records = sorted(records, key=lambda x: x["avg"], reverse=True)

    print("\nStudent Records (Highest to Lowest):")
    for student in sorted_records:
        print(student["name"], "-", *student["grades"], f"| Average: {student['avg']:.2f}")


# ---------------- SEARCH ----------------
def search_student(records):
    search_name = input("\nEnter student name to search: ")

    for student in records:
        if student["name"].lower() == search_name.lower():
            print("\nStudent Found:")
            print(student["name"], "-", *student["grades"], f"| Average: {student['avg']:.2f}")
            return

    print("Student not found.")


# ---------------- REMOVE ----------------
def remove_student(records):
    name_to_remove = input("\nEnter student name to remove: ")

    for student in records:
        if student["name"].lower() == name_to_remove.lower():
            records.remove(student)
            print("Student removed successfully!")
            return

    print("Student not found.")


# ---------------- MAIN MENU ----------------
def main():
    records = load_data()

    while True:
        print("\n===== MENU =====")
        print("1. Add Student")
        print("2. View Students")
        print("3. Search Student")
        print("4. Remove Student")
        print("5. Exit")

        choice = input("Enter choice: ")

        if choice == "1":
            add_student(records)
            save_data(records)

        elif choice == "2":
            view_students(records)

        elif choice == "3":
            search_student(records)

        elif choice == "4":
            remove_student(records)
            save_data(records)

        elif choice == "5":
            save_data(records)
            print("Data saved. Exiting...")
            break

        else:
            print("Invalid choice. Try again.")


# RUN PROGRAM
main()
