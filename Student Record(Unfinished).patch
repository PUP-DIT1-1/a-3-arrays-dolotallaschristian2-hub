import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStreamReader;

public class Leap {

    public static void main(String[] args) throws IOException {

        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));

        System.out.print("Enter number of students: ");
        int students = Integer.parseInt(br.readLine());

        System.out.print("Enter number of grades per student: ");
        int gradesCount = Integer.parseInt(br.readLine());

        String[][] student = new String[students][gradesCount + 1];
        double[] average = new double[students];

        // INPUT
        for (int i = 0; i < students; i++) {

            System.out.print("\nStudent name: ");
            student[i][0] = br.readLine();

            double sum = 0;

            for (int j = 1; j <= gradesCount; j++) {
                System.out.print("Grade " + j + ": ");
                int grade = Integer.parseInt(br.readLine());

                student[i][j] = String.valueOf(grade);
                sum += grade;
            }

            average[i] = sum / gradesCount;
        }

        // SORT (Descending by average)
        for (int i = 0; i < students - 1; i++) {
            for (int j = i + 1; j < students; j++) {

                if (average[i] < average[j]) {

                    // swap averages
                    double tempAvg = average[i];
                    average[i] = average[j];
                    average[j] = tempAvg;

                    // swap entire student row
                    String[] tempRow = student[i];
                    student[i] = student[j];
                    student[j] = tempRow;
                }
            }
        }

        // OUTPUT
        System.out.println("\nSorted Student Records (Highest to Lowest):");

        for (int i = 0; i < students; i++) {

            System.out.print(student[i][0] + " - ");

            for (int j = 1; j <= gradesCount; j++) {
                System.out.print(student[i][j] + " ");
            }

            System.out.printf(" | Average: %.2f\n", average[i]);
        }
    }
}
