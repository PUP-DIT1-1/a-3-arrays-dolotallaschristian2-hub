# INPUT
students = int(input("Enter number of students: "))
grades_count = int(input("Enter number of grades per student: "))

records = []

for i in range(students):
    name = input("\nStudent name: ")

    student_grades = []
    total = 0

    for j in range(grades_count):
        grade = int(input(f"Grade {j + 1}: "))
        student_grades.append(grade)
        total += grade

    avg = total / grades_count
    records.append((name, student_grades, avg))

# SORT (Descending by average)
records.sort(key=lambda x: x[2], reverse=True)

# OUTPUT
print("\nSorted Student Records (Highest to Lowest):")
for name, grades, avg in records:
    print(name, "-", *grades, f"| Average: {avg:.2f}")

# 🔍 SEARCH FUNCTION
search_name = input("\nEnter student name to search: ")

found = False

for name, grades, avg in records:
    if name.lower() == search_name.lower():  # case-insensitive
        print("\nStudent Found:")
        print(name, "-", *grades, f"| Average: {avg:.2f}")
        found = True
        break

if not found:
    print("Student not found.")
